{
  "name": "fusion-gen-matrix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3210",
    "build": "next build --webpack && node scripts/check-client-secrets.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3210",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node scripts/browser-workflow.mjs",
    "db:init": "node --conditions=react-server --import tsx scripts/db-init.ts",
    "security:scan": "node scripts/check-client-secrets.mjs",
    "test:smoke": "node scripts/browser-smoke.mjs",
    "models": "node scripts/build-models.mjs",
    "models:check": "node scripts/build-models.mjs --check"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "latest",
    "@aws-sdk/client-s3": "latest",
    "@aws-sdk/lib-storage": "latest",
    "@base-ui/react": "latest",
    "@react-email/components": "latest",
    "@react-email/render": "latest",
    "@tailwindcss/postcss": "^4.0.0",
    "@tanstack/react-virtual": "latest",
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "clsx": "latest",
    "lucide-react": "latest",
    "mediabunny": "^1.61.6",
    "mongodb": "^6.20.0",
    "next": "^16.4.2",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "latest",
    "server-only": "latest",
    "sharp": "^0.35.5",
    "stripe": "latest",
    "tailwind-merge": "latest",
    "tailwindcss": "^4.0.0",
    "zod": "^4.0.0",
    "zustand": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.2",
    "tsx": "latest",
    "typescript": "^5.9.0",
    "vitest": "latest"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "22.x"
  }
}
