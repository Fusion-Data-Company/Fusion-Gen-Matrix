# Fusion Gen Matrix. Never commit populated secrets.
# demo: loopback-only, local durable sample workflow.
# showcase: public read-only interface. No sign-in, paid generation, uploads or billing.
# live: requires all providers below and fails closed when incomplete.
APP_MODE=demo
APP_URL=http://127.0.0.1:3210
# DATA_DIR defaults to the project's .data; set outside source if preferred.
DATA_DIR=
# Standard live stack: Neon Postgres plus private Vercel Blob.
DATABASE_PROVIDER=postgres
# Runtime pooled connection; only required for DATABASE_PROVIDER=postgres. Never NEXT_PUBLIC_.
DATABASE_URL=
# Direct connection used only by the explicit migration command, not the Vercel app.
DATABASE_URL_UNPOOLED=
MONGODB_URI=
MONGODB_DB=fusion_gen_matrix
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3210
AUTH_RESEND_KEY=
EMAIL_FROM=
ADMIN_EMAILS=
SIGNUP_BONUS_CREDITS=0
HF_CREDENTIALS=
HF_API_BASE_URL=https://api.higgsfield.ai
# Use at least 32 characters for AUTH_SECRET, HF_WEBHOOK_SECRET and CRON_SECRET.
HF_WEBHOOK_SECRET=
HF_WEBHOOK_BASE_URL=
# Comma-separated exact HTTPS provider upload origins, verified from signed-upload responses.
# Configures server validation and browser connect-src. Redeploy after changes; confirm CORS.
HF_UPLOAD_ORIGINS=
MAX_GENERATION_USD=5
CREDIT_MARKUP=2
CREDIT_USD_VALUE=0.01
# Connect an approved private Vercel Blob store before live activation.
MEDIA_STORAGE_PROVIDER=vercel-blob
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Vercel Blob requires a PRIVATE store. The R2 fields above are legacy opt-in compatibility.
# On Vercel, connect the store and let the SDK use platform-managed OIDC.
BLOB_STORE_ID=
# For a runtime without OIDC, an existing server-only token can be supplied instead.
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_PRICES_CONFIRMED=false
ENABLE_LIVE_BILLING=false
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_ULTRA_MONTHLY=
STRIPE_PRICE_ULTRA_ANNUAL=
STRIPE_PRICE_TOPUP_SMALL=
STRIPE_PRICE_TOPUP_MEDIUM=
STRIPE_PRICE_TOPUP_LARGE=
